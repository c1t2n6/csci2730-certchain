PORT=4000
# JSON-RPC endpoint of the chain the contract is deployed on
RPC_URL=http://127.0.0.1:8545
# Change this to any long random string
JWT_SECRET=change-me-to-a-long-random-string
# Frontend origin(s) allowed to call the API, comma separated ("*" = any, fine for local development)
CORS_ORIGIN=*
