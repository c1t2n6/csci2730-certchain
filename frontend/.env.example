# All values are optional. By default the app uses the host name it is opened from:
#   RPC  -> http://<host>:8545   (Hardhat node)
#   API  -> http://<host>:4000   (backend)
# JSON-RPC endpoint used for read-only blockchain queries (e.g. an Alchemy Sepolia URL)
VITE_RPC_URL=
# Backend records service
VITE_API_URL=
# Base URL encoded in certificate QR codes. Use your LAN IP (e.g. http://192.168.1.20:5173)
# so that a phone can open the verification page. Defaults to the current origin.
VITE_PUBLIC_APP_URL=
