# Only needed for deploying to the public Sepolia testnet (optional).
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
DEPLOYER_PRIVATE_KEY=0xYOUR_TEST_WALLET_PRIVATE_KEY
# Comma-separated "address=Name" pairs registered as issuers after deployment.
# If empty, the deployer is registered as the default institution.
INSTITUTIONS=
